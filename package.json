{
  "name": "shipping-logistics-app",
  "version": "2.0.0",
  "description": "A comprehensive shipping & logistics management API built with TypeScript, Express, PostgreSQL, and Prisma ORM.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "ts-node-dev --transpile-only prisma/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "@sendgrid/mail": "8.1.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.2.0",
    "firebase-admin": "13.8.0",
    "helmet": "^7.1.0",
    "hpp": "0.2.3",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "6.10.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "ua-parser-js": "^2.0.9",
    "xss": "1.0.15",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "0.2.7",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "1.4.13",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "6.4.23",
    "@types/qrcode": "^1.5.6",
    "@types/winston": "^2.4.4",
    "prisma": "^5.12.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikay14-ShippingLogisticsApp.git"
  },
  "keywords": [
    "shipping",
    "logistics",
    "typescript",
    "prisma",
    "postgresql"
  ],
  "author": "Ikechukwu Ihemegbulem",
  "license": "ISC"
}
