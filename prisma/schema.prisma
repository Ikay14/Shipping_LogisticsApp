generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderPriority {
  STANDARD
  EXPRESS
  OVERNIGHT
}

enum DockStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum TransactionType {
  PAYMENT
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  WALLET
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  phone              String?   @unique
  passwordHash       String
  role               UserRole  @default(CUSTOMER)
  isActive           Boolean   @default(true)
  isEmailVerified    Boolean   @default(false)
  profileImageUrl    String?
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean   @default(false)
  lastLoginAt        DateTime?
  currentLoginIp     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  orders         Order[]
  transactions   Transaction[]
  managedDocks   ShippingDock[] @relation("DockManager")
  activityLogs   ActivityLog[]
  userTokens     UserToken[]
  loginHistories LoginHistory[]
  orderHistory   OrderHistory[]

  @@map("users")
}

model Order {
  id                 String        @id @default(uuid())
  trackingNumber     String        @unique
  userId             String
  amount             Decimal       @db.Decimal(12, 2)
  taxAmount          Decimal       @db.Decimal(12, 2)
  shippingFee        Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  notes              String?
  status             OrderStatus   @default(PENDING)
  priority           OrderPriority @default(STANDARD)
  originAddress      String
  destinationAddress String
  recipientName      String
  recipientPhone     String
  weightKg           Decimal?      @db.Decimal(8, 3)
  volumetricWeight   Decimal?      @db.Decimal(8, 3)
  dimensions         String?
  estimatedDelivery  DateTime?
  actualDelivery     DateTime?
  originDockId       String?
  destinationDockId  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user            User           @relation(fields: [userId], references: [id])
  originDock      ShippingDock?  @relation("OriginDock", fields: [originDockId], references: [id])
  destinationDock ShippingDock?  @relation("DestinationDock", fields: [destinationDockId], references: [id])
  transactions    Transaction[]
  history         OrderHistory[]

  @@map("orders")
}

model ShippingDock {
  id          String     @id @default(uuid())
  name        String
  code        String     @unique
  status      DockStatus @default(INACTIVE)
  location    String
  address     String?
  capacity    Int        @default(100)
  description String?
  managerId   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  manager           User?         @relation("DockManager", fields: [managerId], references: [id])
  transactions      Transaction[]
  originOrders      Order[]       @relation("OriginDock")
  destinationOrders Order[]       @relation("DestinationDock")

  @@map("shipping_docks")
}

model Transaction {
  id             String            @id @default(uuid())
  reference      String            @unique
  userId         String
  orderId        String
  shippingDockId String
  amount         Decimal           @db.Decimal(12, 2)
  currency       String            @default("NGN")
  type           TransactionType   @default(PAYMENT)
  status         TransactionStatus @default(PENDING)
  paymentMethod  PaymentMethod     @default(CASH)
  notes          String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])
  shippingDock ShippingDock @relation(fields: [shippingDockId], references: [id])

  @@map("transactions")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entity     String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  statusCode Int?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model UserToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  type      String // e.g., 'PASSWORD_RESET', 'EMAIL_VERIFICATION'
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("user_tokens")
}

model LoginHistory {
  id           String   @id @default(uuid())
  userId       String
  ipAddress    String?
  userAgent    String?
  isSuccessful Boolean  @default(false)
  errorMessage String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("login_histories")
}

model OrderHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  notes     String?
  actorId   String? // User who made the change
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_history")
}
