# ─── Server ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── PostgreSQL (local) ──────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/shipping_logistics

# ─── Authentication ──────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_of_at_least_32_characters
JWT_LIFETIME=30d
