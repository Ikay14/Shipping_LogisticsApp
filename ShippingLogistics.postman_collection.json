            "url": {
              "raw": "{{baseUrl}}/docks?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["docks"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Dock by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/docks/:id", "host": ["{{baseUrl}}"], "path": ["docks", ":id"], "variable": [{ "key": "id", "value": "DOCK_ID_HERE" }] }
          }
        },
        {
          "name": "Create Dock (Manager+)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lagos Central Dock\",\n  \"code\": \"LGS-01\",\n  \"location\": \"Apapa, Lagos\",\n  \"address\": \"10 Dockyard Road, Apapa\",\n  \"capacity\": 1000,\n  \"managerId\": \"MANAGER_USER_ID\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/docks", "host": ["{{baseUrl}}"], "path": ["docks"] }
          }
        },
        {
          "name": "Update Dock (Manager+)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"capacity\": 1500,\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/docks/:id", "host": ["{{baseUrl}}"], "path": ["docks", ":id"], "variable": [{ "key": "id", "value": "DOCK_ID_HERE" }] }
          }
        },
        {
          "name": "Delete Dock (Manager+)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/docks/:id", "host": ["{{baseUrl}}"], "path": ["docks", ":id"], "variable": [{ "key": "id", "value": "DOCK_ID_HERE" }] }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "description": "Financial transaction management. All routes require authentication.",
      "item": [
        {
          "name": "Get All Transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/transactions?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Transaction by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/transactions/:id", "host": ["{{baseUrl}}"], "path": ["transactions", ":id"], "variable": [{ "key": "id", "value": "TRANSACTION_ID_HERE" }] }
          }
        },
        {
          "name": "Create Transaction (Manager+)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"USER_ID\",\n  \"orderId\": \"ORDER_ID\",\n  \"shippingDockId\": \"DOCK_ID\",\n  \"amount\": 5000,\n  \"type\": \"PAYMENT\",\n  \"description\": \"Shipping fee for order SL-1234\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] }
          }
        },
        {
          "name": "Update Transaction (Manager+)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\",\n  \"description\": \"Payment confirmed\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/transactions/:id", "host": ["{{baseUrl}}"], "path": ["transactions", ":id"], "variable": [{ "key": "id", "value": "TRANSACTION_ID_HERE" }] }
          }
        },
        {
          "name": "Delete Transaction (Admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/transactions/:id", "host": ["{{baseUrl}}"], "path": ["transactions", ":id"], "variable": [{ "key": "id", "value": "TRANSACTION_ID_HERE" }] }
          }
        }
      ]
    },
    {
      "name": "Activity Logs",
      "description": "Security and audit trail endpoints. All routes require authentication.",
      "item": [
        {
          "name": "Get All Logs (Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/activity-logs?page=1&limit=50&userId=",
              "host": ["{{baseUrl}}"],
              "path": ["activity-logs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "50" },
                { "key": "userId", "value": "", "description": "Optional: filter by a specific user", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get My Activity Logs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/activity-logs/me?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["activity-logs", "me"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Uploads",
      "description": "Global media upload endpoints backed by Firebase Cloud Storage.\n\n**Flags:**\n- `?webp=true` — Convert image to WebP before storing (recommended for avatars/thumbnails)\n- `?docs=true` — Allow document uploads (PDF, CSV, DOCX)",
      "item": [
        {
          "name": "Upload Single File",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [], "description": "Any image file. Add ?docs=true to allow PDFs/CSVs." }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/uploads/single?webp=true",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "single"],
              "query": [
                { "key": "webp", "value": "true", "description": "Convert image to WebP" },
                { "key": "docs", "value": "true", "description": "Allow document types", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Upload Multiple Files",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "files", "type": "file", "src": [], "description": "File 1" },
                { "key": "files", "type": "file", "src": [], "description": "File 2 (max 10)" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/uploads/multiple",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "multiple"],
              "query": [
                { "key": "webp", "value": "true", "description": "Convert all images to WebP", "disabled": true },
                { "key": "docs", "value": "true", "description": "Allow document types", "disabled": true }
              ]
            }
          }
        }
      ]
    }
  ]
}
