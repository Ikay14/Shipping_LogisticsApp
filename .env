# App Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://postgres:12345@127.0.0.1:5432/shipping_logistics
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shipping_logistics
DB_USER=root
DB_PASSWORD=12345
DB_SSL=true

# Auth Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
JWT_LIFETIME=30d

# Email Configuration
# Options: smtp | sendgrid
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=Shipping Logistics
EMAIL_FROM_ADDRESS=no-reply@shippinglogistics.com

# SMTP Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# SendGrid Settings (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=your_sendgrid_api_key

